# Copy this file to .env and replace the placeholder values.
# Never commit .env. Do not put real passwords in this example.

# Required for the catalogue database.
# Application traffic uses the pooled URL. Prisma migrations use the direct URL.
# `neon deploy` writes both into .env.local. Do not commit that file.
# Local PostgreSQL example:
# postgresql://postgres:your-password@localhost:5432/fk_marble?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fk_marble?schema=public"
DATABASE_URL_UNPOOLED=

# Public site URL used later for canonical links. Not required for the database.
NEXT_PUBLIC_SITE_URL=

# Used only by `npm run admin:create-owner`. Leave empty in the example.
# Do not commit real values. There is no public registration page.
ADMIN_OWNER_NAME=
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=

# Reserved for image uploads in a later step. Not required now.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
