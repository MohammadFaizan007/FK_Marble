generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EnquiryType {
  WHOLESALE
  RETAIL
}

enum EnquiryStatus {
  PENDING
  CONTACTED
  COMPLETED
  CANCELLED
}

enum QuantityUnit {
  SQ_FT
  SQ_M
  PIECES
  SLABS
  BOXES
}

enum PriceUnit {
  SQ_FT
  PIECE
  SLAB
}

enum AdminRole {
  OWNER
  ADMIN
  MANAGER
  SALES
  PURCHASE
  INVENTORY
  ACCOUNTANT
}

model AdminUser {
  id           String         @id @default(cuid())
  name         String
  email        String         @unique
  passwordHash String
  role         AdminRole
  isActive     Boolean        @default(true)
  sessions     AdminSession[]
  auditLogs    AuditLog[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, expiresAt])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String
  createdAt  DateTime   @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model Category {
  id           String    @id
  name          String
  nameHi        String?
  slug          String    @unique
  description   String
  descriptionHi String?
  image         String
  isActive     Boolean   @default(true)
  displayOrder Int
  products     Product[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isActive, displayOrder])
}

model Product {
  id           String         @id
  name           String
  nameHi         String?
  slug           String         @unique
  description    String
  descriptionHi  String?
  categoryId     String
  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  material       String
  materialHi     String?
  size           String?
  thickness      String?
  finish         String?
  finishHi       String?
  color          String?
  colorHi        String?
  usage          String?
  usageHi        String?
  price          Decimal?       @db.Decimal(12, 2)
  wholesalePrice Decimal?     @db.Decimal(12, 2)
  costPrice      Decimal?     @db.Decimal(12, 2)
  priceUnit    PriceUnit?
  showPrice    Boolean        @default(false)
  availability   String
  availabilityHi String?
  isFeatured   Boolean        @default(false)
  isActive     Boolean        @default(true)
  isDemo       Boolean        @default(false)
  images       ProductImage[]
  enquiries    Enquiry[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([categoryId])
  @@index([isActive, isDemo])
  @@index([isFeatured])
  @@index([material])
  @@index([color])
  @@index([finish])
  @@index([size])
}

model ProductImage {
  id                 String   @id
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl           String
  cloudinaryPublicId String?
  altText            String
  isPrimary          Boolean  @default(false)
  displayOrder       Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([productId, displayOrder])
}

model Enquiry {
  id           String        @id @default(cuid())
  customerName String
  phone        String
  email        String?
  productId    String?
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String?
  enquiryType  EnquiryType
  quantity     Decimal?      @db.Decimal(12, 2)
  quantityUnit QuantityUnit?
  message      String?
  status       EnquiryStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([productId])
}

model Supplier {
  id          String   @id
  name        String
  contactName String?
  phone       String?
  email       String?
  address     String?
  gstin       String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, name])
}

model BusinessSettings {
  id                  String   @id
  businessName        String
  tagline             String
  phone               String
  whatsappNumber      String
  address             String
  city                String
  state               String
  openingTime         String
  closingTime         String
  businessDescription String
  updatedAt           DateTime @updatedAt
}
